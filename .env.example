# =============================================================================
# Tinceram Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env with real secrets.
#
# Categories:
#   REQUIRED     — must be set for the application to work
#   OPTIONAL     — enhance functionality but not strictly required
#   DEV-ONLY     — development helpers, MUST NOT be used in production
#   PRODUCTION   — required ONLY in production (ENVIRONMENT=production)
# =============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED — Core
# ──────────────────────────────────────────────────────────────────────────────

# Database (docker-compose injects these into containers)
POSTGRES_USER=ceramics
POSTGRES_PASSWORD=ceramics_dev
POSTGRES_DB=ceramics
DATABASE_URL=postgresql+psycopg://ceramics:ceramics_dev@db:5432/ceramics

# Redis
REDIS_URL=redis://redis:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
INTERNAL_API_URL=http://backend:8000/api/v1

# MinIO media storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=tinceram-media
S3_SECURE=false

# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED — Security
# ──────────────────────────────────────────────────────────────────────────────

# JWT signing key (MUST be ≥32 chars random string in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Separate refresh token secret (optional, falls back to SECRET_KEY)
# REFRESH_SECRET_KEY=

# Admin panel credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ──────────────────────────────────────────────────────────────────────────────
# PRODUCTION — Security (required when ENVIRONMENT=production)
# ──────────────────────────────────────────────────────────────────────────────

# ENVIRONMENT=production
ENVIRONMENT=development

# Must be true in production (requires HTTPS)
AUTH_COOKIES_SECURE=false

# Seed admin account (for initial setup only)
SEED_ADMIN_EMAIL=admin@tinceram.local
SEED_ADMIN_PASSWORD=admin1234

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Payment Gateway
# ──────────────────────────────────────────────────────────────────────────────

ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_SANDBOX=true

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Email (SMTP) for transactional email
# ──────────────────────────────────────────────────────────────────────────────

# Leave SMTP_HOST empty to log emails to console (development only)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=TinCeram <no-reply@tinceram.ir>
# SMTP_TLS=true

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL — SMS Provider (Kavenegar-compatible HTTP API)
# ──────────────────────────────────────────────────────────────────────────────

# Leave SMS_API_URL empty to log SMS to console (development only)
# SMS_API_URL=https://api.kavenegar.com/v1/{api_key}/sms/send.json?receptor={receptor}&message={message}&sender={sender}
# SMS_API_KEY=your-kavenegar-api-key
# SMS_SENDER=your-sender-number

# ──────────────────────────────────────────────────────────────────────────────
# DEV-ONLY — Development Helpers (NEVER use in production)
# ──────────────────────────────────────────────────────────────────────────────

# Return OTP codes in API responses (development convenience)
# MUST be false in production — production validator rejects this
SMS_DEBUG=true

# Rate limiting (disable for tests)
RATE_LIMIT_ENABLED=true

# Access token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime (days)
REFRESH_TOKEN_EXPIRE_DAYS=30

# Login lockout
MAX_LOGIN_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
