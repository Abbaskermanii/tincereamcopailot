"use client";

import React, { useState, useEffect, useMemo } from "react";
import { notFound } from "next/navigation";
import { api, SITE_URL } from "@/lib/api";
import { Breadcrumbs } from "@/components/ui/breadcrumbs";
import { Badge } from "@/components/ui/badge";
import { PriceTag } from "@/components/ui/price-tag";
import { ProductGallery } from "@/components/store/product-gallery";
import { AddToCartPanel } from "@/components/store/add-to-cart";
import { StickyBuyBar } from "@/components/store/sticky-buy-bar";
import { RecentlyViewed } from "@/components/store/recently-viewed";
import { TrackRecentlyViewed } from "@/components/store/track-recently-viewed";
import { RelatedProducts } from "@/components/store/related-products";
import { ProductReviews } from "@/components/store/product-reviews";
import { ProductQuestions } from "@/components/store/product-questions";
import { StockNotify } from "@/components/store/stock-notify";
import { faNum } from "@/lib/format";

interface ProductImage {
  id: string;
  url: string;
  alt_text: string;
  sort_order: number;
  is_primary: boolean;
}

interface Variant {
  id: string;
  name: string;
  sku: string;
  image_url?: string;
  price_delta: number;
  absolute_price: number | null;
  stock_qty: number;
  is_active: boolean;
}

interface Product {
  id: string;
  slug: string;
  name: string;
  price: number;
  compare_at_price?: number | null;
  discount_percent?: number;
  stock_qty: number;
  images: ProductImage[];
  variants?: Variant[];
  material?: string | null;
  dimensions?: string | null;
  weight_grams?: number;
  short_description?: string;
  description?: string;
  sku?: string;
  primary_image_url?: string | null;
  category_slug?: string | null;
}

interface Props {
  params: { slug: string };
}

function mapApiProduct(raw: NonNullable<Awaited<ReturnType<typeof api.product>>>): Product {
  return {
    id: raw.id,
    slug: raw.slug,
    name: raw.name,
    price: raw.price,
    compare_at_price: raw.compare_at_price,
    discount_percent: raw.discount_percent,
    stock_qty: raw.stock_qty,
    images: raw.images?.map((img: ProductImage) => ({
      id: img.id,
      url: img.url,
      alt_text: img.alt_text,
      sort_order: img.sort_order,
      is_primary: img.is_primary,
    })) ?? [],
    variants: raw.variants?.map((v: Variant) => ({
      id: v.id,
      name: v.name,
      sku: v.sku ?? "",
      image_url: v.image_url,
      price_delta: v.price_delta,
      absolute_price: v.absolute_price,
      stock_qty: v.stock_qty,
      is_active: v.is_active ?? true,
    })) ?? [],
    material: raw.material ?? "",
    dimensions: raw.dimensions ?? "",
    weight_grams: raw.weight_grams,
    short_description: raw.short_description ?? "",
    description: raw.description ?? "",
    sku: raw.sku ?? "",
    primary_image_url: raw.primary_image_url ?? undefined,
    category_slug: raw.category_slug,
  };
}

export default function ProductPage({ params }: Props) {
  const [p, setP] = useState<Product | null>(null);
  const [selectedVariant, setSelectedVariant] = useState<Variant | null>(null);
  const [notFoundCalled, setNotFoundCalled] = useState(false);

  useEffect(() => {
    let cancelled = false;
    async function load() {
      const raw = await api.product(params.slug);
      if (cancelled) return;
      if (!raw) { setNotFoundCalled(true); return; }
      setP(mapApiProduct(raw));
    }
    void load();
    return () => { cancelled = true; };
  }, [params.slug]);

  const handleVariantSelect = React.useCallback(
    (variant: {
      id: string;
      name: string;
      sku?: string;
      image_url?: string;
      price_delta: number;
      absolute_price: number | null;
      stock_qty: number;
    }) => {
      // Empty id means no variant selected (or parent requested reset) — clear
      if (!variant.id) {
        setSelectedVariant(null);
        return;
      }
      setSelectedVariant({
        id: variant.id,
        name: variant.name,
        sku: (variant as unknown as { sku?: string }).sku ?? "",
        image_url: variant.image_url,
        price_delta: variant.price_delta,
        absolute_price: variant.absolute_price,
        stock_qty: variant.stock_qty,
        is_active: true,
      } as Variant);
    },
    []
  );

  const effectivePrice = useMemo(() => {
    if (!p) return 0;
    if (!selectedVariant) return p.price;
    if (selectedVariant.absolute_price !== null && selectedVariant.absolute_price !== undefined) return Number(selectedVariant.absolute_price);
    return p.price + Number(selectedVariant.price_delta ?? 0);
  }, [p, selectedVariant]);
  const effectiveStock = selectedVariant ? selectedVariant.stock_qty : p?.stock_qty ?? 0;
  const effectiveSku = selectedVariant?.sku || p?.sku || "";

  const jsonLd = useMemo(() => {
    if (!p) return null;
    const img = selectedVariant?.image_url ? { url: selectedVariant.image_url } : p.images?.[0];
    const sku = effectiveSku;
    return {
      "@context": "https://schema.org",
      "@type": "Product",
      name: selectedVariant ? `${p.name} — ${selectedVariant.name}` : p.name,
      description: p.short_description ?? p.description?.slice(0, 300) ?? "",
      image: img?.url ? [img.url] : [],
      sku: sku ?? "",
      brand: { "@type": "Brand", name: "TinCeram" },
      offers: {
        "@type": "Offer",
        url: `${SITE_URL}/product/${p.slug ?? ""}`,
        priceCurrency: "IRR",
        price: String(Math.round(effectivePrice ?? 0)),
        availability:
          effectiveStock > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
        itemCondition: "https://schema.org/NewCondition",
      },
    };
  }, [p, selectedVariant, effectivePrice, effectiveStock, effectiveSku]);

  const breadcrumbLd = useMemo(() => {
    if (!p) return null;
    return {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "خانه", item: SITE_URL },
        {
          "@type": "ListItem",
          position: 2,
          name: p.name,
          item: `${SITE_URL}/product/${p.slug}`,
        },
      ],
    };
  }, [p]);

  useEffect(() => {
    if (!jsonLd || !breadcrumbLd) return;
    const existing1 = document.querySelector('script[type="application/ld+json"]:first-child');
    if (existing1) existing1.remove();
    const s1 = document.createElement("script");
    s1.type = "application/ld+json";
    s1.textContent = JSON.stringify(jsonLd);
    document.head.appendChild(s1);

    const existing2 = document.querySelector('script[type="application/ld+json"]:nth-child(2)');
    if (existing2) existing2.remove();
    const s2 = document.createElement("script");
    s2.type = "application/ld+json";
    s2.textContent = JSON.stringify(breadcrumbLd);
    document.head.appendChild(s2);
  }, [jsonLd, breadcrumbLd]);

  if (notFoundCalled) notFound();
  if (!p) return <div className="mx-auto max-w-7xl px-4 py-20 text-center text-char-soft">در حال بارگذاری محصول…</div>;

  return (
    <div className="mx-auto max-w-7xl px-4 py-8 pb-24 md:px-6 md:pb-12">
      <TrackRecentlyViewed
        slug={p?.slug ?? ""}
        name={p?.name ?? ""}
        price={p?.price ?? 0}
        imageUrl={p?.images?.[0]?.url ?? ""}
      />

      <Breadcrumbs
        items={[
          { name: "خانه", href: "/" },
          { name: p?.category_slug ? p.category_slug : "محصول", href: p?.category_slug ? `/category/${p.category_slug}` : "/shop" },
          { name: p?.name },
        ]}
      />

      <div className="grid gap-10 lg:grid-cols-[1.2fr_1fr]">
        {/* gallery — sticky on desktop */}
        <div className="lg:sticky lg:top-28 lg:self-start">
          <ProductGallery
            images={p.images}
            productName={p.name}
            variantImageUrl={selectedVariant?.image_url}
            variantName={selectedVariant?.name}
          />
        </div>

        {/* info column */}
        <div id="buy-box" className="space-y-6">
          <div>
            <h1 className="text-2xl font-extrabold leading-snug md:text-3xl">
              {p.name}
              {selectedVariant && <span className="mr-2 text-lg font-medium text-char-soft">— {selectedVariant.name}</span>}
            </h1>
            <p className="num-latin mt-2 text-xs text-char-soft dark:text-ink-soft" dir="ltr">
              {effectiveSku}
            </p>
            {selectedVariant && <p className="mt-1 text-xs text-firouzeh">گونه انتخاب شده: {selectedVariant.name}</p>}
          </div>

          {p.short_description && (
            <p className="leading-8 text-char-soft dark:text-ink-soft">
              {p.short_description}
            </p>
          )}

          <div className="flex flex-wrap items-center gap-3">
            <PriceTag price={effectivePrice} compareAtPrice={p.compare_at_price} size="lg" />
            {p.discount_percent && p.discount_percent > 0 && (
              <Badge tone="warm">٪{faNum(p.discount_percent)} تخفیف</Badge>
            )}
            {effectiveStock > 0 ? (
              <Badge tone="success">موجود در انبار {effectiveStock <= 5 ? `— فقط ${faNum(effectiveStock)} عدد` : ""}</Badge>
            ) : (
              <Badge tone="muted">ناموجود</Badge>
            )}
            {selectedVariant && <Badge tone="brand">{selectedVariant.name}</Badge>}
          </div>

          {effectiveStock <= 0 && <StockNotify productId={p.id} />}
          <AddToCartPanel
            product={{
              id: p.id,
              slug: p.slug,
              name: p.name,
              price: p.price,
              stock_qty: p.stock_qty,
              primary_image_url: p.primary_image_url ?? p.images[0]?.url ?? "",
              variants: p.variants,
            }}
            onVariantSelect={handleVariantSelect}
          />

          <dl className="space-y-3 rounded-wobble bg-surface p-5 text-sm shadow-shelf">
            {[
              ["جنس", p.material],
              ["ابعاد", p.dimensions],
              ["وزن", p.weight_grams ? `حدود ${faNum(p.weight_grams)} گرم` : null],
            ]
              .filter((row): row is [string, string] => Boolean(row[1]))
              .map(([k, v]) => (
                <div key={k} className="flex justify-between gap-4">
                  <dt className="text-char-soft dark:text-ink-soft">{k}</dt>
                  <dd className="font-medium">{v}</dd>
                </div>
              ))}
          </dl>

          <details className="group rounded-wobble bg-surface p-5" open>
            <summary className="cursor-pointer list-none font-bold">
              توضیحات کامل
            </summary>
            <p className="mt-3 whitespace-pre-line text-sm leading-8 text-char-soft dark:text-ink-soft">
              {p.description}
            </p>
          </details>

          <details className="rounded-wobble bg-surface p-5">
            <summary className="cursor-pointer list-none font-bold">نگهداری و ارسال</summary>
            <ul className="mt-3 list-inside list-disc space-y-1.5 text-sm leading-7 text-char-soft dark:text-ink-soft">
              <li>شست‌وشو با دست و اسفنج نرم؛ برای ماشین ظرفشویی مناسب نیست.</li>
              <li>زمان ارسال: ۲ تا ۴ روز کاری، بسته‌بندی چندلایه و ضدضرب.</li>
              <li>هزینهٔ ارسال بر اساس روش انتخابی در صفحهٔ تسویه حساب محاسبه می‌شود.</li>
            </ul>
          </details>
        </div>
      </div>

      <RelatedProducts categorySlug={p.category_slug ?? null} excludeSlug={p.slug} />
      <ProductReviews productId={p.id} />
      <ProductQuestions productId={p.id} />
      <RecentlyViewed excludeSlug={p.slug} />
      <StickyBuyBar name={selectedVariant ? `${p.name} — ${selectedVariant.name}` : p.name} price={effectivePrice} />
    </div>
  );
}