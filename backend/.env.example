# ==================== DATABASE CONFIGURATION ====================
# PostgreSQL database connection details
# These are injected by docker-compose environment variables

POSTGRES_USER=ceramics
POSTGRES_PASSWORD=change-me-in-production-strong-password-min-32-chars
POSTGRES_DB=ceramics
DATABASE_URL=postgresql+psycopg://ceramics:change-me-in-production-strong-password-min-32-chars@db:5432/ceramics

# Test database (optional)
POSTGRES_TEST_USER=ceramics_test
POSTGRES_TEST_PASSWORD=test_password
POSTGRES_TEST_DB=ceramics_test
DATABASE_TEST_URL=postgresql+psycopg://ceramics_test:test_password@db-test:5432/ceramics_test

# ==================== REDIS CONFIGURATION ====================
# Redis cache connection
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=60
REDIS_LOCK_TIMEOUT=30

# ==================== SECURITY CONFIGURATION ====================
# JWT security keys - MUST be strong random strings in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Access token secret (access tokens expire in 30 minutes by default)
SECRET_KEY=change-me-in-production-min-32-characters-strong-random-key

# Refresh token secret (refresh tokens expire in 30 days by default)
# Different from SECRET_KEY for security if possible
REFRESH_SECRET_KEY=change-me-in-production-min-32-characters-unique-key

# Application security settings
# Environment: development | production | test
ENVIRONMENT=development

# Enable/disable security features
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds
CSRF_ENABLED=true
CSRF_TOKEN_SECRET=change-me-in-production-csrf-token-min-32-chars

# Password strength requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# Authentication settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_LOGIN_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# Cookie security
AUTH_COOKIES_SECURE=false  # Set to true in production with HTTPS
AUTH_COOKIES_SAMESITE=lax  # lax | strict | none

# ==================== ZARINPAL PAYMENT GATEWAY ====================
# Iranian payment gateway - ZarinPal
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_SANDBOX=true

# ==================== ADMIN PANEL CONFIGURATION ====================
# Admin panel access
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production-strong-password

# First admin account (for seeding)
SEED_ADMIN_EMAIL=admin@tinceram.local
SEED_ADMIN_PASSWORD=change-me-in-production-strong-password

# ==================== FRONTEND CONFIGURATION ====================
# Next.js application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
INTERNAL_API_URL=http://backend:8000/api/v1

# Next.js app settings
NEXT_PUBLIC_APP_NAME=TinCeram
NEXT_PUBLIC_APP_DESCRIPTION=Premium ceramic products for your home
NEXT_PUBLIC_APP_SENTRY_DSN= # Optional: Sentry error tracking

# ==================== MINIO STORAGE CONFIGURATION ====================
# S3-compatible object storage for media files
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-production-min-12-char-password

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-in-production-min-12-char-password
S3_BUCKET=tinceram-media
S3_BUCKET_SECURE=false

# Media file settings
# Upload size limits (max 10MB for frontend, 100MB for admin)
MAX_IMAGE_SIZE=10485760  # 10MB in bytes
MAX_FILE_SIZE=104857600  # 100MB in bytes

# Allowed file types
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif,image/avif
ALLOWED_DOCUMENT_TYPES=application/pdf

# ==================== SMTP EMAIL CONFIGURATION ====================
# Email service for transactional emails (password reset, order confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=TinCeram <no-reply@tinceram.local>
SMTP_TLS=true
SMTP_STARTTLS=true

# Email sending settings
# Development mode: send to console instead of SMTP
EMAIL_DEBUG=false
# Production: use actual SMTP server
EMAIL_FROM=TinCeram <no-reply@tinceram.local>
EMAIL_REPLY_TO=support@tinceram.local

# ==================== SMS NOTIFICATION CONFIGURATION ====================
# SMS provider for OTP and notifications (e.g., Kavenegar)
SMS_API_URL= # e.g., https://restapi.kavenegar.com/v1/{api_key}/send/lookup
SMS_API_KEY=your-sms-api-key
SMS_SENDER=your-sender-number
SMS_DEBUG=false  # Set to true for development to see OTPs in logs

# ==================== APPLICATION SETTINGS ====================
# App name and branding
APP_NAME=TinCeram
APP_DESCRIPTION=Premium ceramic products for your home
APP_URL=http://localhost:3000

# Timezone configuration
TZ=Asia/Tehran

# CORS settings (allowed origins for frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Debug mode
DEBUG=true

# ==================== ANALYTICS & TRACKING ====================
# Google Analytics (optional)
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Google Tag Manager (optional)
# GTM_CONTAINER_ID=GTM-XXXXXX

# ==================== DEVELOPMENT TOOLS ====================
# Development server settings
HOST=0.0.0.0
PORT=8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000

# WebSocket (if needed)
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=8001

# ==================== DEPLOYMENT ====================
# Production settings
# These should be set in production environment
PRODUCTION_MODE=false
DEPLOYMENT_ENVIRONMENT=production

# SSL/TLS configuration (requires reverse proxy)
SSL_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# ==================== ADVANCED SETTINGS ====================
# Caching settings
CACHE_ENABLED=true
CACHE_TYPE=redis
CACHE_TTL=60

# Logging settings
LOG_LEVEL=info  # debug, info, warning, error
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/var/log/tinceram/app.log

# Performance settings
ENABLE_QUERY_LOGGING=false
ENABLE_RESPONSE_COMPRESSION=true

# ==================== BACKUP & RETENTION ====================
# Database backup configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Every day at 2:00 AM
BACKUP_RETENTION_DAYS=7

# ==================== GDPR & COMPLIANCE ====================
# GDPR compliance settings
GDPR_ENABLED=true
GDPR_COOKIE_CONSENT=true
GDPR_COOKIES_NEEDED=false  # Change to true if using cookie tracking
GDPR_COOKIE_EXPIRY_DAYS=30

# ==================== NOTIFICATIONS ====================
# Notification system
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_SYSTEM_ENABLED=true

# ==================== ADDITIONAL SETTINGS ====================
# Session settings
SESSION_SECRET=change-me-in-production-session-secret-min-32-characters
SESSION_MAX_AGE=86400  # 24 hours
SESSION_DOMAIN=

# Rate limiting settings for different endpoints
RATE_LIMIT_PUBLIC_API=100  # per minute
RATE_LIMIT_AUTH_API=5  # per minute
RATE_LIMIT_ORDER_API=10  # per minute
RATE_LIMIT_PAYMENT_API=3  # per minute

# Upload settings
MAX_UPLOAD_SIZE=104857600  # 100MB
MAX_UPLOAD_FILES=10
ENABLE_IMAGE_PROCESSING=true
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
IMAGE_QUALITY=85

# Search settings
SEARCH_ENABLED=true
SEARCH_ENGINE=elasticsearch  # or none for database search

# SEO settings
ENABLE_SEO=true
ENABLE_SITEMAP=true
ENABLE_ROBOTS_TXT=true
ENABLE_STRUCTURED_DATA=true

# ==================== ENVIRONMENT SPECIFIC SETTINGS ====================
# Development settings
DEV_ENV=true
DEV_HOT_RELOAD=true
DEV_API_DOCUMENTATION=true

# Production settings (uncomment and set when deploying)
# PROD_ENV=true
# PROD_HOT_RELOAD=false
# PROD_API_DOCUMENTATION=false

# ==================== THIRD PARTY INTEGRATIONS ====================
# Kave Negar (Iranian SMS provider)
KAVE_NEGAR_API_KEY=

# Sepidar (Iranian payment gateway alternative)
SEPIDAR_MERCHANT_ID=
SEPIDAR_SANDBOX=true

# IDPay (Iranian payment gateway alternative)
IDPAY_MERCHANT_ID=
IDPAY_SANDBOX=true

# ==================== END OF CONFIGURATION ====================
# Notes:
# 1. Always use strong random passwords. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 2. Never commit actual secrets to version control
# 3. Set environment-specific variables in deployment environment
# 4. Review this file during deployment checklist